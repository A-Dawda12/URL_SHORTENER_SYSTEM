# Local Docker Compose — copy to .env

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
APP_BASE_URL=http://localhost:8080
IP_HASH_SALT=change-me-for-click-analytics

# --- Free cloud deploy (Render + Vercel) — set in Render dashboard, not here ---

# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/url_shortener
# REDIS_HOST=xxx.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your-upstash-password
# REDIS_SSL=true
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# APP_BASE_URL=https://your-api.onrender.com

# --- Vercel frontend env (set in Vercel dashboard) ---

# VITE_API_URL=https://your-api.onrender.com